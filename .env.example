# ─── Banco de Dados (PostgreSQL) ──────────────────────────────
POSTGRES_USER=entrelinhas
POSTGRES_PASSWORD=sua_senha_segura
POSTGRES_DB=entrelinhas_db

# Aliases usados pelo backend localmente (mesmo valor das variáveis acima)
DB_HOST=localhost
DB_PORT=5432
DB_USER=entrelinhas
DB_PASSWORD=sua_senha_segura
DB_NAME=entrelinhas_db

# Produção Supabase Postgres: definir DB_HOST do painel (*.supabase.co).
# TLS liga por padrão nesse caso; pode forçar com DB_SSL=true ou desligar com DB_SSL=false (ex.: Postgres local nomeado "supabase").
#DB_SSL=true

# ─── Backend (NestJS) ─────────────────────────────────────────
NODE_ENV=development
PORT=3000

# JWT — basta UM destes padrões:
# A) Somente JWT_SECRET (≥16 caracteres): access + refresh são derivados;
#      não precisa declarar JWT_ACCESS_SECRET / JWT_REFRESH_SECRET (nem deixar VAR=vazio).
# B) Produção recomendado: JWT_ACCESS_SECRET + JWT_REFRESH_SECRET (cada uma ≥16), distintas uma da outra.
#    Se JWT_REFRESH_SECRET for omitido, ela é derivada de JWT_ACCESS_SECRET (ou JWT_SECRET).
JWT_SECRET=troque_por_uma_chave_muito_segura_com_no_minimo_16_chars
#JWT_ACCESS_SECRET=
#JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Legado Docker antigo — preferir JWT_ACCESS_EXPIRES_IN acima:
#JWT_EXPIRES_IN=15m

# Lista separada por vírgulas (protocolo + host obrigatórios para o navegador)
CORS_ORIGINS=http://localhost:4200,http://localhost:80,http://127.0.0.1:4200
 
# Logs (pino via nestjs-pino)
LOG_LEVEL=info

# Rate limit (Throttle): login e upload usam valores fixos próximos a estes nos controllers
THROTTLE_LOGIN_LIMIT=15
THROTTLE_LOGIN_TTL_SEC=60
THROTTLE_UPLOAD_LIMIT=60
THROTTLE_UPLOAD_TTL_SEC=3600

# Upload: limite máximo por arquivo (bytes); validação por assinatura no buffer em memória
UPLOAD_MAX_FILE_BYTES=5242880

# ─── Supabase Storage (opcional — recomendado no deploy gratuito Render/Vercel) ───
# 1) Dashboard → Storage → novo bucket minúsculo (ex.: entrelinhas-uploads).
# 2) Bucket → público OU política para leitura anônima (senão o navegador não carrega `<img>`).
# 3) Pegar SUPABASE_URL (Settings → API) e service_role secret (somente servidor / Render).
# Com as três definidas: API grava arquivo no bucket e guarda só a URL pública no Postgres (`imagem_url`).
# Omitir tudo isto mantém comportamento anterior: arquivos em ./uploads e URL do próprio backend.
#SUPABASE_URL=https://??????.supabase.co
#SUPABASE_SERVICE_ROLE_KEY=
#SUPABASE_STORAGE_BUCKET=entrelinhas-uploads

# Opcional monitoramento — HTTPS obrigatório se definido (validado pelo Zod)
SENTRY_DSN=
